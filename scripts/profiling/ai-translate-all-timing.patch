diff --git a/instr/src-ui/app/editor-ai-timing-debug.js b/src-ui/app/editor-ai-timing-debug.js
new file mode 100644
index 0000000..7a95c6b
--- /dev/null
+++ b/src-ui/app/editor-ai-timing-debug.js
@@ -0,0 +1,70 @@
+// TEMPORARY profiling helper for the AI Translate All audit. Remove after use.
+// Writes "ai-timing:*" events to the editor debug log file
+// (~/Library/Application Support/com.gnosis.tms/logs/editor-scroll-debug.jsonl)
+// and mirrors them to the console.
+
+import { logEditorScrollDebug } from "./editor-scroll-debug.js";
+import { getEditorOperationQueueSnapshot, waitForEditorOperationQueueIdle } from "./editor-operation-queue.js";
+
+const now = () => (typeof performance === "object" && typeof performance.now === "function"
+  ? performance.now()
+  : Date.now());
+
+let runT0 = 0;
+
+export function aiTimingRunStart(detail = {}) {
+  runT0 = now();
+  aiTimingMark("run-start", detail);
+}
+
+export function aiTimingMark(event, detail = {}) {
+  const payload = { tMs: Math.round(now() - runT0), ...detail };
+  // The debug-log flusher needs a real window (unit tests stub one without timers).
+  if (typeof globalThis.window?.setTimeout === "function") {
+    logEditorScrollDebug(`ai-timing:${event}`, payload);
+    console.info(`[ai-timing] ${event}`, payload);
+  }
+}
+
+// Returns end(detail) which logs the elapsed time for `event`.
+export function aiTimingStart(event, detail = {}) {
+  const t0 = now();
+  return (endDetail = {}) => {
+    const ms = Math.round((now() - t0) * 10) / 10;
+    aiTimingMark(event, { ms, ...detail, ...endDetail });
+    return ms;
+  };
+}
+
+// After a run: wait for the editor write queue to drain and dump per-operation
+// queue wait / run durations for the batch saves this run enqueued.
+export async function aiTimingDrainQueue(sinceIso) {
+  const end = aiTimingStart("queue-drain");
+  await waitForEditorOperationQueueIdle();
+  const drainMs = end();
+  const snapshot = getEditorOperationQueueSnapshot();
+  const ops = snapshot.operations
+    .filter((op) => !sinceIso || (op.queuedAt && op.queuedAt >= sinceIso))
+    .map((op) => ({
+      kind: op.kind,
+      status: op.status,
+      rows: Array.isArray(op.metadata?.rowIds) ? op.metadata.rowIds.length : null,
+      waitMs: op.startedAt && op.queuedAt ? Date.parse(op.startedAt) - Date.parse(op.queuedAt) : null,
+      runMs: op.finishedAt && op.startedAt ? Date.parse(op.finishedAt) - Date.parse(op.startedAt) : null,
+    }));
+  const summary = { drainMs, count: ops.length };
+  for (const kind of new Set(ops.map((op) => op.kind))) {
+    const list = ops.filter((op) => op.kind === kind);
+    summary[kind] = {
+      count: list.length,
+      rows: list.reduce((sum, op) => sum + (op.rows ?? 0), 0),
+      waitMsTotal: list.reduce((sum, op) => sum + (op.waitMs ?? 0), 0),
+      runMsTotal: list.reduce((sum, op) => sum + (op.runMs ?? 0), 0),
+      runMsMax: Math.max(0, ...list.map((op) => op.runMs ?? 0)),
+    };
+  }
+  aiTimingMark("queue-summary", summary);
+  for (const op of ops.slice(0, 60)) {
+    aiTimingMark("queue-op", op);
+  }
+}
