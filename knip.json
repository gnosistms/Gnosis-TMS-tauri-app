{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src-ui/app/*.test.js",
    "src-ui/screens/*.test.js",
    "scripts/build-frontend-for-tauri.mjs",
    "scripts/glossary-research-lab/studio-budget-comparison.mjs",
    "docs/app.js"
  ],
  "project": [
    "**/*.{js,mjs}"
  ],
  "ignore": [
    "alignment-lab/**"
  ],
  "ignoreExportsUsedInFile": true,
  "paths": {
    "/app/*": [
      "./src-ui/app/*"
    ],
    "/screens/*": [
      "./src-ui/screens/*"
    ]
  }
}
